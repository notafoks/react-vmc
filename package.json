{
  "name": "react-vmc",
  "version": "0.1.0",
  "description": "React view models with MobX and dependency injection.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run check",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "mobx": "^6.9.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.0.0 || ^19.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/react": "^18.3.31",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.5.1",
    "tsyringe": "^4.10.0",
    "typescript": "~5.9.3"
  },
  "keywords": ["react", "mobx", "view-model", "mvvm", "tsyringe", "typescript"]
}
